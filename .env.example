# Google Gemini API Key
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Model selection (defaults to gemini-3.6-flash, fallback is gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.6-flash

# Vercel AI Gateway API Key (Optional backup / multi-model router)
# Get yours at: https://vercel.com/~/ai-gateway
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here
# VERCEL_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_GATEWAY_DEFAULT_MODEL=google/gemini-2.5-flash
# AI_PROVIDER_DEFAULT=auto
